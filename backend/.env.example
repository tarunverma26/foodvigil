# =============================================================================
# FoodVigil Backend Environment Configuration
# =============================================================================

PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# FoodVigil has built-in DUAL DATABASE SUPPORT:
# 1. Cloud PostgreSQL / Supabase (Set DATABASE_URL below)
# 2. Local SQLite (Leave DATABASE_URL blank/commented out to use local SQLite)

# Option A: Connect to Supabase PostgreSQL (Recommended for Production)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Option B: Connect to Neon.tech Serverless Postgres
# DATABASE_URL=postgresql://[user]:[password]@[ep-xyz].neon.tech/foodvigil?sslmode=require

# Option C: Connect to Local / Docker PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodvigil

# Option D: Offline / Local Zero-Config SQLite (Default)
# (Leave DATABASE_URL commented out - database will be saved to backend/data/foodvigil.sqlite automatically)
